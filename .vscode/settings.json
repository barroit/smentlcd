{
   "files.associations": {
      "**/Makefile.*": "makefile",
      "**/*.awk": "plaintext",
   },
   "search.exclude": {
      "**/kconfiglib": true,
      "**/libdeflate": true,
      "**/libusb": true,
      "**/tapview": true,
      "**/stb": true,
   },
   "git.ignoredRepositories": [
      "kconfiglib",
      "libdeflate",
      "libusb",
      "stb",
      "tapview",
   ],
   "C_Cpp.default.cStandard": "gnu17",
   "C_Cpp.default.includePath": [
      "${workspaceFolder}/libdeflate",
      "${workspaceFolder}/include",
      "${workspaceFolder}/libusb/libusb",
      "${workspaceFolder}/stb",
      "${workspaceFolder}/t/unit/include",
   ],
   "C_Cpp.default.forcedInclude": [
      "${workspaceFolder}/include/generated/build.h",
      "${workspaceFolder}/include/generated/config.h",
      "${workspaceFolder}/include/generated/features.h",
      "${workspaceFolder}/include/generated/unitest.h",
   ],
   "C_Cpp.default.defines": [
      "_GNU_SOURCE",
   ],
}
