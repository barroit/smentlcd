CFLAGS :=
LDFLAGS :=

CFLAGS += -std=gnu17

ifneq ($(USE_CLANG),)
  LDFLAGS += --ld-path=$(file <build/probe/ld/program)
else ifneq ($(USE_GCC),)
  LDFLAGS += -B$(shell dirname $(file <build/probe/ld/program))
endif

LDFLAGS += -fuse-ld=$(LD)

CFLAGS += $(CONFIG_CC_OPTIMIZE_LEVEL)

CFLAGS += $(CONFIG_DEBUG_INFO_FORMAT)

ifneq ($(CONFIG_ENABLE_DEBUG),)
  CFLAGS += -fno-omit-frame-pointer
endif

ifneq ($(CONFIG_DEBUG_INFO_COMPRESS_ZLIB),)
  CFLAGS += -gz=zlib
  LDFLAGS += -Wl,--compress-debug-sections=zlib
else ifneq ($(CONFIG_DEBUG_INFO_COMPRESS_ZSTD),)
  CFLAGS += -gz=zstd
  LDFLAGS += -Wl,--compress-debug-sections=zstd
endif

ifneq ($(CONFIG_ENABLE_SANITIZER),)
  CFLAGS += -fsanitize=address,undefined
  LDFLAGS += -fsanitize=address,undefined
endif

ifneq ($(and $(CONFIG_ENABLE_TEST),$(CC_HAS_TOPLEVEL_REORDER)),)
  CFLAGS += -fno-toplevel-reorder
endif

CFLAGS += -funsigned-char

CFLAGS += -MMD -MP

CFLAGS += -Wall \
	  -Wbad-function-cast \
	  -Wformat-security \
	  -Winit-self \
	  -Wmissing-declarations \
	  -Wmissing-prototypes \
	  -Wnested-externs \
	  -Wno-system-headers \
	  -Wold-style-definition \
	  -Wpacked \
	  -Wstrict-prototypes \
	  -Wno-switch \
	  -Wshadow \
	  -Wno-parentheses

CFLAGS += -iquote include

CFLAGS += -isystem libdeflate \
	  -isystem libusb/libusb \
	  -isystem stb

CFLAGS += -include include/generated/config.h

CFLAGS += -D_GNU_SOURCE

ifeq ($(CONFIG_ENABLE_DEBUG),)
  CFLAGS += -DNDEBUG
endif

DAEMON_LDFLAGS += -pthread

ifeq ($(SERVICE),systemd)
  LDFLAGS += -lsystemd
  DAEMON_LDFLAGS += -ludev
endif

ifneq ($(CONFIG_EMBED_CONFIG),)
  ifneq ($(CC_EMITS_ELF),)
    LDFLAGS += -Wl,-b,binary,build/.config,-b,default,-T,scripts/kconfig.ld
  else ifneq ($(CC_EMITS_MACH),)
    LDFLAGS += -Wl,-sectcreate,__TEXT,kconfig,build/.config
  endif
endif

build/.flags.cc: .force
	@$(call mv_stale_c,printf '%s\n' '$(CFLAGS)',$@)

build/.flags.ld: .force
	@$(call mv_stale_c,printf '%s\n' '$(LDFLAGS)',$@)

build/.flags.ld-daemon: .force
	@$(call mv_stale_c,printf '%s\n' '$(DAEMON_LDFLAGS)',$@)
