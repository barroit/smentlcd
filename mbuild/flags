CFLAGS :=
LDFLAGS :=

CFLAGS += -std=gnu17

ifneq ($(USE_CLANG),)
  LDFLAGS += --ld-path=$$(cat build/probe/ld/program)
else ifneq ($(USE_GCC),)
  LDFLAGS += -B$(shell dirname $$(cat build/probe/ld/program))
endif

LDFLAGS += -fuse-ld=$(LD)

CFLAGS += $(CONFIG_CC_OPTIMIZE_LEVEL)

ifneq ($(CONFIG_DEBUG_INFO_DWARF4),)
  CFLAGS += -gdwarf-4
else ifneq ($(CONFIG_DEBUG_INFO_DWARF5),)
  CFLAGS += -gdwarf-5
endif

ifneq ($(CONFIG_ENABLE_DEBUG),)
  CFLAGS += -fno-omit-frame-pointer
endif

ifneq ($(CONFIG_DEBUG_INFO_COMPRESS_ZLIB),)
  CFLAGS += -gz=zlib
  LDFLAGS += -Wl,--compress-debug-sections=zlib
else ifneq ($(CONFIG_DEBUG_INFO_COMPRESS_ZSTD),)
  CFLAGS += -gz=zstd
  LDFLAGS += -Wl,--compress-debug-sections=zstd
endif

ifneq ($(CONFIG_ENABLE_SANITIZER),)
  CFLAGS += -fsanitize=address,undefined
  LDFLAGS += -fsanitize=address,undefined
endif

ifneq ($(and $(CONFIG_ENABLE_TEST),$(CC_HAS_TOPLEVEL_REORDER)),)
  CFLAGS += -fno-toplevel-reorder
endif

CFLAGS += -funsigned-char

CFLAGS += -MMD -MP

CFLAGS += -Wall \
	  -Wbad-function-cast \
	  -Wformat-security \
	  -Winit-self \
	  -Wmissing-declarations \
	  -Wmissing-prototypes \
	  -Wnested-externs \
	  -Wno-system-headers \
	  -Wold-style-definition \
	  -Wpacked \
	  -Wstrict-prototypes \
	  -Wno-switch \
	  -Wshadow

CFLAGS += -Wno-parentheses

CFLAGS += -iquote include

CFLAGS += -isystem libdeflate \
	  -isystem libusb/libusb \
	  -isystem stb

CFLAGS += -include include/generated/config.h

CFLAGS += -D_GNU_SOURCE

ifeq ($(CONFIG_ENABLE_DEBUG),)
  CFLAGS += -DNDEBUG
endif

DAEMON_LDFLAGS += -pthread

ifeq ($(SERVICE),systemd)
  LDFLAGS += -lsystemd
  DAEMON_LDFLAGS += -ludev
endif

build/.flags.cc: .force
	@trap 'rm -f .tmp-$$$$' EXIT && \
	printf '%s\n' "$(CFLAGS)" >.tmp-$$$$ && \
	$(call mv_stale,.tmp-$$$$,$(@),)

build/.flags.ld: .force
	@trap 'rm -f .tmp-$$$$' EXIT && \
	printf '%s\n' "$(LDFLAGS)" >.tmp-$$$$ && \
	$(call mv_stale,.tmp-$$$$,$(@),)

build/.flags.ld-daemon: .force
	@trap 'rm -f .tmp-$$$$' EXIT && \
	printf '%s\n' "$(DAEMON_LDFLAGS)" >.tmp-$$$$ && \
	$(call mv_stale,.tmp-$$$$,$(@),)
