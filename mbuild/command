.NOTINTERMEDIATE: build/%/.cmdtree build/%/.cmdnode build/%/.cmdlist

include/generated/%/cmdtab.h: build/%/.cmdlist scripts/cmd-tab.sh
	@mkdir -p $(@D)
	grep '\.c' $< | ./scripts/cmd-tab.sh $* >$@

build/%/.cmdtree: .force scripts/cmd-tree.py
	@mkdir -p $(@D)
	@$(call mv_stale_c,./scripts/cmd-tree.py $*,$@)

build/%/.cmdnode: build/%/.cmdlist scripts/cmd-node.py
	./scripts/cmd-node.py $* >$@

build/%/.cmdlist: .force
	@mkdir -p $(@D)
	@$(call mv_stale_c,find $* -maxdepth 1 | \
			   grep -v '_entry\.c$$' | sort,$@)

%_entry.c: | %.c
	./scripts/cmd-entry.sh $* >$@
