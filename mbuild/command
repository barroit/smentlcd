include/%/cmdtab.h:
	mkdir -p $(@D)
	printf '%s\n' $| | sort | ./scripts/cmd-tab.sh $@ >$@

build/%/cmdtree: build/%/.commands scripts/cmd-tree.py
	./scripts/cmd-tree.py $*/main.c >$@

build/%/.commands: .force
	@mkdir -p $(@D)
	@trap 'rm -f .tmp-$$$$' EXIT && \
	find $* -type f -not -name '*_entry.c' | sort >.tmp-$$$$ && \
	$(call mv_stale,.tmp-$$$$,$(@),)

%_entry.c: | %.c
	./scripts/cmd-entry.sh $* >$@
