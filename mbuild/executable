build/ctl/%/entry: build/.flags.ld \
		   $(obj-lib) $(obj-lib_ctl) \
		   build/libdeflate.a
	mkdir -p $(@D)
	$(CC) $(filter %.o,$^) \
	      $(filter %.a,$^) \
	      $(LDFLAGS) \
	      -o $@

build/daemon/%/entry: build/.flags.ld build/.flags.ld-daemon \
		      $(obj-lib) $(obj-lib_daemon) \
		      build/libusb.a
	mkdir -p $(@D)
	$(CC) $(filter %.o,$^) \
	      $(filter %.a,$^) \
	      $(LDFLAGS) $(DAEMON_LDFLAGS) \
	      -o $@

build/libusb.a: libusb/libusb-1.0.a
	mkdir -p $(@D)
	ln -f $< $@

build/libdeflate.a: libdeflate/build/libdeflate.a
	mkdir -p $(@D)
	ln -f $< $@

libusb/libusb-1.0.a libdeflate/build/libdeflate.a:
	$(error No $@ found. \
		Run 'scripts/build-$(firstword $(subst /, ,$@)).sh' first)
