.PHONY: install uninstall

install: install_$(SERVICE)

uninstall: uninstall_$(SERVICE)

.PHONY: install_systemd uninstall_systemd

install_systemd: install_program
	printf 'SUBSYSTEM=="usb", ATTR{idVendor}=="%04x", ATTR{idProduct}=="%04x", GROUP:="smentlcd", MODE:="0660"\n' \
	       $(CONFIG_DEVICE_VID) $(CONFIG_DEVICE_PID) | \
	sudo tee /etc/udev/rules.d/39-smentlcd.rules

	sudo groupadd -f smentlcd
	sudo udevadm control --reload-rules

	mkdir -p $(HOME)/.config/systemd/user
	install -m $$(umask -S),a-x \
		systemd/smentlcd.service systemd/smentlcd.socket \
		$(HOME)/.config/systemd/user
	systemctl --user daemon-reload

uninstall_systemd:
	systemctl --user disable --now smentlcd.socket
	systemctl --user stop smentlcd.service
	rm -f $(HOME)/.config/systemd/user/smentlcd.service \
	      $(HOME)/.config/systemd/user/smentlcd.socket
	rm -f $(HOME)/.local/bin/$(name)d $(HOME)/.local/bin/$(name)ctl
	systemctl --user daemon-reload

	sudo rm /etc/udev/rules.d/39-smentlcd.rules

	sudo udevadm control --reload-rules
	sudo groupdel smentlcd

.PHONY: install_program

install_program: build/ctl/main/entry build/daemon/main/entry
	mkdir -p $(HOME)/.local/bin
	install -m $$(umask -S) $(word 1,$^) $(HOME)/.local/bin/$(name)ctl
	install -m $$(umask -S) $(word 2,$^) $(HOME)/.local/bin/$(name)d
